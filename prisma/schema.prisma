generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Radio {
  id           Int      @id
  position     Int
  slug         String   @unique
  name         String
  genre        String
  description  String
  streamUrl    String
  logo         String
  originalLogo String   @default("")
  status       String   @default("online")
  color        String   @default("from-cyan-600 to-fuchsia-900")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  health       StreamHealth?
  events       AnalyticsEvent[]
}

model StreamHealth {
  id        Int      @id @default(autoincrement())
  radioId   Int      @unique
  isOnline  Boolean  @default(false)
  title     String   @default("")
  art       String   @default("")
  listeners Int      @default(0)
  bitrate   String   @default("")
  checkedAt DateTime @default(now())
  lastError String   @default("")

  radio     Radio    @relation(fields: [radioId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  radioId   Int?
  slug      String
  type      String
  userAgent String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  radio     Radio?   @relation(fields: [radioId], references: [id], onDelete: SetNull)
}
